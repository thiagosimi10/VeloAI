APP_NAME=VeloAI Provisioning
APP_ENV=development
LOG_LEVEL=INFO

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=veloai_admin
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_MAINTENANCE_DB=postgres
POSTGRES_MASTER_DB=veloai_master
# Nome da role de aplicação para a qual o Provisioning concede privilégios (GRANT) em
# cada novo banco — o Provisioning nunca autentica como esta role.
POSTGRES_APP_USER=veloai_app

DATABASE_MASTER_URL=postgresql+asyncpg://veloai_admin:change-me-in-production@postgres:5432/veloai_master

# Qdrant (RAG — Fase 15): o Provisioning cria a Collection do tenant aqui.
QDRANT_URL=http://qdrant:6333

# Bootstrap do primeiro operador do Painel Administrativo (Fase 18), lido por
# scripts/seed_master.py no boot do container. Sem esses dois valores, a etapa é
# pulada (nunca falha o boot).
PLATFORM_ADMIN_EMAIL=admin@veloai.internal
PLATFORM_ADMIN_PASSWORD=change-me-in-production
