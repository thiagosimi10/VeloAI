# syntax=docker/dockerfile:1
# Imagem de desenvolvimento: roda o uvicorn com --reload, diferente do backend/Dockerfile
# (que builda uma vez e nunca observa mudança de arquivo). Código-fonte (app/ e o pacote
# shared/) é montado como volume pelo docker-compose.yml, nunca copiado aqui — só o
# necessário pra instalar as dependências antes do volume entrar.
FROM python:3.13-slim
WORKDIR /srv

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONPATH=/srv/backend

RUN apt-get update && apt-get install -y --no-install-recommends build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY shared /srv/shared
COPY backend/requirements.txt /srv/backend/requirements.txt
WORKDIR /srv/backend
RUN pip install -r requirements.txt

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload", \
     "--reload-dir", "/srv/backend/app", "--reload-dir", "/srv/shared"]
