APP_NAME=VeloAI Backend
APP_ENV=development
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
CORS_ALLOWED_ORIGINS=http://localhost:5173

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_MASTER_DB=veloai_master
POSTGRES_APP_USER=veloai_app
POSTGRES_APP_PASSWORD=change-me-in-production

REDIS_URL=redis://redis:6379/0

JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-in-production
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=14
COOKIE_SECURE=false

# Painel Administrativo (Fase 18) — secret próprio, nunca reaproveita JWT_SECRET.
PLATFORM_ADMIN_JWT_SECRET=change-me-in-production
PLATFORM_ADMIN_TOKEN_EXPIRE_MINUTES=60

LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900

SIGNUP_RATE_LIMIT_MAX_ATTEMPTS=5
SIGNUP_RATE_LIMIT_WINDOW_SECONDS=3600

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=veloai_minio
MINIO_SECRET_KEY=change-me-in-production
MINIO_USE_SSL=false
MINIO_BUCKET_NAME=veloai-attachments

QDRANT_URL=http://qdrant:6333

AI_GATEWAY_URL=http://ai-gateway:8002

# URL pública do frontend — usada para montar os links de retorno do Checkout Asaas.
FRONTEND_BASE_URL=http://localhost:5173

# Gateway de pagamento (Asaas). Preencher com a API Key da conta sandbox/produção.
ASAAS_API_KEY=
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
# Mesmo valor configurado como "authToken" ao criar o Webhook no painel Asaas.
ASAAS_WEBHOOK_TOKEN=change-me-in-production
