# =============================================================================
# VeloAI — Variáveis de Ambiente (raiz / docker-compose)
# Nunca versionar o arquivo .env real. Copiar este arquivo para .env.
# =============================================================================

APP_NAME=VeloAI
APP_ENV=development
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# PostgreSQL (host único nesta fase — hospeda o Banco Master + bancos de tenant)
# -----------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=veloai_master
POSTGRES_MASTER_DB=veloai_master

# Role administrativa — usada exclusivamente pelo Provisioning Service (CREATE
# DATABASE/DROP DATABASE/CREATE SCHEMA/GRANT). Nunca usada pelo Backend.
POSTGRES_USER=veloai_admin
POSTGRES_PASSWORD=change-me-in-production
# Banco de manutenção usado apenas para emitir CREATE DATABASE/DROP DATABASE
# (nunca armazena dados — ver 19-PROVISIONING-SERVICE.md).
POSTGRES_MAINTENANCE_DB=postgres

# Role de aplicação — usada exclusivamente pelo Backend para ler/escrever dados no
# Banco Master e nos bancos de tenant. Sem privilégio de CREATE DATABASE/CREATE SCHEMA
# (18-DATABASE-02, 29-SECURITY.md: "Nunca utilizar usuário postgres na aplicação").
POSTGRES_APP_USER=veloai_app
POSTGRES_APP_PASSWORD=change-me-in-production

DATABASE_MASTER_URL=postgresql+asyncpg://veloai_admin:change-me-in-production@postgres:5432/veloai_master

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# -----------------------------------------------------------------------------
# MinIO
# -----------------------------------------------------------------------------
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=veloai_minio
MINIO_SECRET_KEY=change-me-in-production
MINIO_USE_SSL=false
MINIO_BUCKET_NAME=veloai-attachments

# -----------------------------------------------------------------------------
# Segurança / Autenticação (Backend)
# -----------------------------------------------------------------------------
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-in-production
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=14
ENCRYPTION_KEY=change-me-in-production
# Cookies HttpOnly do access/refresh token exigem HTTPS em produção. Em dev local
# (http://localhost) deve ficar false, senão o navegador descarta os cookies.
COOKIE_SECURE=false
# Bloqueio temporário contra força bruta no login (29-SECURITY.md).
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900

# -----------------------------------------------------------------------------
# Inteligência Artificial (AI Gateway)
# -----------------------------------------------------------------------------
AI_PROVIDER=google
AI_REPORT_MODEL=gemini-3.1-flash-lite
GEMINI_API_KEY=
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=8192
# TTL do cache de respostas do AI Gateway (Response Cache via Redis, Fase 13).
AI_CACHE_TTL_SECONDS=3600

# -----------------------------------------------------------------------------
# URLs internas de serviço
# -----------------------------------------------------------------------------
BACKEND_URL=http://backend:8000
PROVISIONING_URL=http://provisioning:8001
# Usada pelo Backend para chamar o AI Gateway (Fase 13) — o Backend é o único
# consumidor; nunca é chamada diretamente pelo Frontend.
AI_GATEWAY_URL=http://ai-gateway:8002
VITE_API_URL=http://localhost:8000
